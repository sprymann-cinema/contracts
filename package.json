{
  "name": "@sprymann-cinema/contracts",
  "version": "1.0.2",
  "description": "Protobuf definitions and generated TypeScript types",
  "main": "index.js",
  "scripts": {
    "generate": "npx protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "files": [
    "proto",
    "gen"
  ],
  "dependencies": {
    "@nestjs/microservices": "^11.2.1",
    "rxjs": "^7.8.2",
    "ts-proto": "^2.12.1"
  },
  "author": {
    "name": "George"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "https://github.com/sprymann-cinema/contracts"
  }
}
